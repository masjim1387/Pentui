/* Deliberately monochrome: PentUI is a text-first terminal application. */
Screen { background: transparent; color: white; }
Header, Footer { background: transparent; color: white; }

#tool-panel { width: 62; height: auto; border: round white; padding: 1 3; margin-top: 3; }
#brand { content-align: center middle; text-style: bold; margin-bottom: 1; }
.section-title, .group-title { text-style: bold; margin-top: 1; }
.coming-soon { color: ansi_bright_black; padding: 0 2; }

Button { width: 100%; margin: 0; padding: 0 1; border: none; background: transparent; color: white; }
Button:hover, Button:focus { background: transparent; color: white; text-style: reverse bold; }

#config-root, #execution-root { height: 1fr; border: round white; margin: 1 2; padding: 1 2; background: transparent; }
#screen-title { text-style: bold; }
#command-preview, #run-command { border: tall ansi_bright_black; padding: 0 1; margin-bottom: 1; background: transparent; }
#arguments { height: 1fr; }
.argument { height: 1; text-align: left; margin: 0; padding: 0 1; }
#target-input { margin: 1 0; border: tall white; background: transparent; }
#target-input:focus { border: tall white; background: transparent; text-style: reverse; }
#output { height: 1fr; border: tall ansi_bright_black; padding: 1; background: transparent; }
#execution-actions { height: auto; align: right middle; margin-top: 1; }
#stop-scan { width: 18; border: tall white; }

ValueInputModal { align: center middle; background: transparent; }
#modal-dialog { width: 60; height: auto; background: black; border: round white; padding: 2; }
#modal-title { text-style: bold; margin-bottom: 1; }
.modal-buttons { height: auto; margin-top: 1; }
.modal-buttons Button { width: 1fr; margin: 0 1; border: tall ansi_bright_black; }
